<Window x:Class="SocialMatrix.WpfHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="易洋出海"
        Icon="/EyochSocial;component/Assets/social-matrix.ico"
        Height="900" Width="1400" 
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F7F9FC"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="MainWindowChrome"
                           CaptionHeight="0"
                           ResizeBorderThickness="6"
                           CornerRadius="12"
                           GlassFrameThickness="0"
                           UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#EAF2FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D7E7FF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="close" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#F04438" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="close" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#B42318" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="WindowHeaderBorder"
                Grid.Row="0"
                Background="#F7F9FC"
                CornerRadius="12,12,0,0"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown"
                MouseMove="WindowHeader_MouseMove"
                MouseLeftButtonUp="WindowHeader_MouseLeftButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="144" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 图形来自 yudao-ui-admin-vue3/src/assets/imgs/logo.svg -->
                    <Viewbox Width="24" Height="24" Margin="12,0,8,0">
                        <Canvas Width="96" Height="96">
                            <Path Data="M23,24 H39 L48,40 L57,24 H73 L55,54 V73 H41 V54 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.24,0.25" EndPoint="0.58,0.76">
                                        <GradientStop Color="#BF0992" Offset="0" />
                                        <GradientStop Color="#1B91E3" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="易洋出海"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#24324A" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Width="48"
                            Height="40"
                            Click="MinimizeButton_Click"
                            Foreground="#64748B">
                        <Border Width="12" Height="1" Background="#64748B" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Width="48"
                            Height="40"
                            Click="MaximizeButton_Click"
                            Foreground="#64748B">
                        <Border Width="11" Height="11" BorderBrush="#64748B" BorderThickness="1" />
                    </Button>
                    <Button Width="48"
                            Height="40"
                            Style="{StaticResource WindowButtonStyle}"
                            Tag="close"
                            Click="CloseButton_Click"
                            Content="×"
                            FontSize="20"
                            Foreground="#64748B" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wpf:WebView2 x:Name="VueWebView" />
        </Grid>
    </Grid>
</Window>
