<Window x:Class="SocialMatrix.WpfHost.Windows.MessageMonitorConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="消息接收账号配置" Width="760" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="选择消息接收账号" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="CapacityText" Foreground="#666" Margin="0,6,0,12" />
            <TextBlock Text="定时接收会在设置的时间点检查一次并关闭浏览器；手动上线功能仍在消息管理页面使用。业务采集、运营和私信优先。" TextWrapping="Wrap" Foreground="#999" Margin="0,0,0,10" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="保存" Width="90" Click="Save_Click" />
        </StackPanel>
        <DataGrid x:Name="AccountGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="52">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Facebook账号" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" />
                <DataGridTemplateColumn Header="接收方式" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding ModeLabel}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="scheduled" Content="定时接收" />
                                <ComboBoxItem Tag="disabled" Content="关闭" />
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="定时接收时间" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ScheduleTimeList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel VerticalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" ContentStringFormat="{}{0}  ×" Tag="{Binding}" Click="RemoveTime_Click"
                                                    Margin="0,2,6,2" Padding="8,3" MinWidth="58"
                                                    Background="#ecf5ff" Foreground="#409eff" BorderBrush="#b3d8ff"
                                                    ToolTip="删除此时间" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="+ 添加时间" Click="AddTime_Click" Padding="8,4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
