<Window x:Class="SocialMatrix.WpfHost.Windows.MessageMonitorConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="消息接收账号配置" Width="760" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="选择消息接收账号" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="CapacityText" Foreground="#666" Margin="0,6,0,12" />
            <TextBlock Text="实时在线会持续占用浏览器名额；定时检查只在检查时占用。业务采集、运营和私信优先。" TextWrapping="Wrap" Foreground="#999" Margin="0,0,0,10" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="保存" Width="90" Click="Save_Click" />
        </StackPanel>
        <DataGrid x:Name="AccountGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Facebook账号" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" />
                <DataGridTemplateColumn Header="接收方式" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding ModeLabel}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="realtime" Content="实时在线" />
                                <ComboBoxItem Tag="scheduled" Content="定时检查" />
                                <ComboBoxItem Tag="disabled" Content="不接收" />
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="检查间隔(分钟)" Binding="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
