<Window x:Class="SocialMatrix.WpfHost.Windows.MessageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Facebook消息管理"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        WindowState="Maximized"
        ShowInTaskbar="True"
        Background="#D9DEE7"
        WindowStartupLocation="Manual">
    <Border BorderBrush="#8B95A5" BorderThickness="1" Margin="4" Background="#F5F7FA">
      <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12">
                        <TextBlock Margin="0,0,0,8" Text="消息管理" FontSize="18" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="+" Width="36" Height="32" Margin="0,0,6,6" FontSize="18" FontWeight="SemiBold" ToolTip="管理接收账号" Click="ManagePool_Click" />
                        <Button Content="上线" Width="72" Height="32" Margin="0,0,6,6" Click="BringOnline_Click" />
                        <Button Content="下线" Width="72" Height="32" Margin="0,0,0,6" Click="SetScheduled_Click" />
                    </WrapPanel>
                    <TextBox x:Name="AccountSearchBox" Height="30" Padding="8,4" TextChanged="AccountSearchBox_TextChanged" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="SelectedCountText" Text="已选 0 个" Foreground="#909399" Margin="12,8,12,10" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock Text="在线" FontWeight="SemiBold" Margin="12,4,12,4" Foreground="#1B8F77" />
                    <ListBox x:Name="RealtimeAccountList" BorderThickness="0" SelectionChanged="AccountList_SelectionChanged" />
                    <TextBlock Text="离线" FontWeight="SemiBold" Margin="12,14,12,4" Foreground="#409EFF" />
                    <ListBox x:Name="ScheduledAccountList" BorderThickness="0" SelectionChanged="AccountList_SelectionChanged" />
                  </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="#EDEFF2">
            <Grid x:Name="BrowserHost">
                <TextBlock x:Name="BrowserEmptyText" Text="请选择账号" Foreground="#909399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="SelectionTranslationPopup" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="360" Padding="10,7"
                        Background="#1F2937" CornerRadius="4" Panel.ZIndex="20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SelectionTranslationText" Foreground="White" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="快捷话术" FontWeight="SemiBold" FontSize="15" />
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="ScriptSearchButton" DockPanel.Dock="Right" Content="搜索" Width="64" Height="30" Margin="8,0,0,0" Click="ScriptSearchButton_Click" />
                            <TextBox x:Name="ScriptSearchBox" Height="30" Padding="8,4" ToolTip="搜索话术标题" />
                        </DockPanel>
                        <ListBox x:Name="ScriptList" Height="360" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,8,0,14" SelectionChanged="ScriptList_SelectionChanged" />
                        <DockPanel Margin="0,0,0,14">
                            <Button x:Name="ScriptNextButton" DockPanel.Dock="Right" Content="下一页" Width="64" Height="28" Click="ScriptNextButton_Click" />
                            <Button x:Name="ScriptPreviousButton" DockPanel.Dock="Right" Content="上一页" Width="64" Height="28" Margin="0,0,6,0" Click="ScriptPreviousButton_Click" />
                            <TextBlock x:Name="ScriptPageText" Text="第 1 页" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="回复" Foreground="#606266" />
                        <TextBox x:Name="ReplyChineseBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,0" LostFocus="ReplyChineseBox_LostFocus" />
                        <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="目标语言" VerticalAlignment="Center" />
                        <ComboBox x:Name="TargetLanguageBox" Width="160" Margin="8,0,0,0" SelectionChanged="TargetLanguageBox_SelectionChanged">
                            <ComboBoxItem Tag="en" Content="英语" />
                            <ComboBoxItem Tag="es" Content="西班牙语" />
                            <ComboBoxItem Tag="pt" Content="葡萄牙语" />
                            <ComboBoxItem Tag="ar" Content="阿拉伯语" />
                            <ComboBoxItem Tag="fr" Content="法语" />
                            <ComboBoxItem Tag="de" Content="德语" />
                            <ComboBoxItem Tag="it" Content="意大利语" />
                            <ComboBoxItem Tag="ru" Content="俄语" />
                            <ComboBoxItem Tag="ja" Content="日语" />
                            <ComboBoxItem Tag="ko" Content="韩语" />
                            <ComboBoxItem Tag="tr" Content="土耳其语" />
                            <ComboBoxItem Tag="id" Content="印度尼西亚语" />
                            <ComboBoxItem Tag="th" Content="泰语" />
                            <ComboBoxItem Tag="vi" Content="越南语" />
                            <ComboBoxItem Tag="zh" Content="中文" />
                        </ComboBox>
                        <CheckBox x:Name="AutoTranslateCheckBox" Content="自动翻译" IsChecked="False" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="发送内容" Foreground="#606266" Margin="0,14,0,0" />
                        <TextBox x:Name="ReplyTranslatedBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <DockPanel LastChildFill="False" Margin="0,12,0,0">
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送" Width="100" Height="40" Click="SendButton_Click" />
                        <Button x:Name="TranslateButton" DockPanel.Dock="Right" Content="翻译" Width="100" Height="40" Margin="0,0,8,0" Click="TranslateButton_Click" />
                        <ProgressBar x:Name="TranslationProgress" DockPanel.Dock="Right" Width="24" Height="24" Margin="0,8,10,8" IsIndeterminate="True" Visibility="Collapsed" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
      </Grid>
    </Border>
</Window>
