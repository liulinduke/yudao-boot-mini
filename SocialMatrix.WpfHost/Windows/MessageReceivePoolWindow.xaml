<Window x:Class="SocialMatrix.WpfHost.Windows.MessageReceivePoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理消息接收账号" Width="860" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="管理消息接收账号" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="加入接收池后会定时上线接收Messager消息和通知。" Foreground="#777" Margin="0,6,0,12" />
            <StackPanel Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Height="32" Padding="8,4" ToolTip="搜索 Facebook 账号" TextChanged="SearchBox_TextChanged" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="定时接收间隔" VerticalAlignment="Center" />
                    <TextBox x:Name="IntervalBox" Text="60" Width="64" Height="30" Padding="8,4" Margin="10,0,5,0" />
                    <TextBlock Text="分钟" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="100" Height="38" Click="SaveSchedule_Click" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="未加入接收池" FontWeight="SemiBold" Foreground="#909399" Margin="0,0,0,8" />
                    <ListBox x:Name="AvailableList" BorderThickness="0" />
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="加入接收池" Width="112" Height="38" Margin="4" Click="Add_Click" />
                <Button Content="移出接收池" Width="112" Height="38" Margin="4" Click="Remove_Click" />
            </StackPanel>
            <Border Grid.Column="2" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="已加入接收池" FontWeight="SemiBold" Foreground="#1B8F77" Margin="0,0,0,8" />
                    <ListBox x:Name="PoolList" BorderThickness="0" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
