<Window x:Class="SocialMatrix.WpfHost.Windows.MessageReceivePoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理消息接收账号" Width="860" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="管理消息接收账号" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="加入接收池后会定时上线接收Messager消息和通知。" Foreground="#777" Margin="0,6,0,12" />
            <StackPanel Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Height="32" Padding="8,4" ToolTip="搜索 Facebook 账号" TextChanged="SearchBox_TextChanged" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="消息接收：" VerticalAlignment="Center" />
                    <TextBlock Text="定时接收" Foreground="#409EFF" VerticalAlignment="Center" />
                    <TextBlock Text="    接收时间：" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ItemsControl x:Name="ScheduleTimesPanel" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" ContentStringFormat="{}{0}  ×" Tag="{Binding}"
                                        Click="RemoveTime_Click" Margin="0,0,6,0" Padding="8,3"
                                        Background="#ecf5ff" Foreground="#409eff" BorderBrush="#b3d8ff"
                                        ToolTip="删除此时间" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ 添加时间" Click="AddTime_Click" Padding="8,3" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="100" Height="38" Click="SaveSchedule_Click" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="未加入接收池" FontWeight="SemiBold" Foreground="#909399" Margin="0,0,0,8" />
                    <ListBox x:Name="AvailableList" BorderThickness="0" />
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="加入接收池" Width="112" Height="38" Margin="4" Click="Add_Click" />
                <Button Content="移出接收池" Width="112" Height="38" Margin="4" Click="Remove_Click" />
            </StackPanel>
            <Border Grid.Column="2" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="已加入接收池" FontWeight="SemiBold" Foreground="#1B8F77" Margin="0,0,0,8" />
                    <ListBox x:Name="PoolList" BorderThickness="0" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
