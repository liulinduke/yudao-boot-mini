<Window x:Class="SocialMatrix.WpfHost.Windows.BrowserMatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浏览器矩阵 - SocialMatrix" 
        Height="700" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TabControl x:Name="BrowserTabs" Grid.Row="0" Margin="0" Height="34" />
        <Grid x:Name="BrowserHostGrid" Grid.Row="1" />
    </Grid>
</Window>
