<Window x:Class="SocialMatrix.WpfHost.Windows.BrowserMatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浏览器矩阵 - SocialMatrix" 
        Height="700" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="BrowserTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousTabButton" Grid.Column="0" Content="&lt;" Click="PreviousBrowserTab_Click"
                                    ToolTip="上一个账号" FontSize="14" Width="30" Height="28" MinHeight="0"
                                    VerticalAlignment="Center" Padding="0"
                                    Visibility="Collapsed" />
                            <ScrollViewer x:Name="HeaderScrollViewer" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <TabPanel IsItemsHost="True" />
                            </ScrollViewer>
                            <Button x:Name="NextTabButton" Grid.Column="2" Content="&gt;" Click="NextBrowserTab_Click"
                                    ToolTip="下一个账号" FontSize="14" Width="30" Height="28" MinHeight="0"
                                    VerticalAlignment="Center" Padding="0"
                                    Visibility="Collapsed" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TabControl x:Name="BrowserTabs" Grid.Row="0" Margin="0" Height="34"
                    Style="{StaticResource BrowserTabControlStyle}" />
        <Grid x:Name="BrowserHostGrid" Grid.Row="1" />
    </Grid>
</Window>
