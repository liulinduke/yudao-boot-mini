<?xml version="1.0"?>
<Obfuscator>
  <Var name="InPath" value=".\artifacts\wpf-publish" />
  <Var name="OutPath" value=".\artifacts\wpf-obfuscated" />
  <Var name="KeepPublicApi" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />

  <Module file="$(InPath)\EyochSocial.dll">
    <!-- WPF/XAML 和 Vue HostObject 依赖这些公开类型/方法名。 -->
    <SkipType name="SocialMatrix.WpfHost.App" />
    <SkipType name="SocialMatrix.WpfHost.MainWindow" />
    <SkipType name="SocialMatrix.WpfHost.Services.JsBridgeService" />
  </Module>
</Obfuscator>
